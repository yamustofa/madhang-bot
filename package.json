{
	"name": "makan-siang",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"description": "Telegram bot that turns the office 'makan siang apa hari ini?' debate into a live status board.",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "wrangler dev",
		"db:apply:local": "wrangler d1 execute madhang --local --file=src/db/schema.sql",
		"db:apply": "wrangler d1 execute madhang --remote --file=src/db/schema.sql",
		"build": "wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check"
	},
	"dependencies": {
		"grammy": "^1.30.0",
		"hono": "^4.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/workers-types": "^4.20250101.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.5",
		"wrangler": "^4.70.0"
	},
	"trustedDependencies": []
}
